rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Teacher Profile Collection
    match /teachers/{teacherUid} {
      allow get: if isOwner(teacherUid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isOwner(teacherUid) 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.phoneNumber is string;
      allow delete: if false;
    }

    // Lesson Plans Collection
    match /lesson_plans/{lessonId} {
      allow get: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.subject is string;
      allow update: if isSignedIn() 
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isSignedIn() 
        && resource.data.teacherUid == request.auth.uid;
    }

    // Historical Activity Logs (Audit trail)
    match /activity_logs/{logId} {
      allow get: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false; // Immutable audit history
    }
  }
}
